{
	"schemaVersion": 1,
	"id": "ultimatefist",
	"version": "${version}",
	"name": "Ultimate Fist",
	"description": "This mod is a simple reimplementation of the Ultimate Fist mod for Beta 1.3_01.",
	"authors": [
		"BoredBanana"
	],
	"contact": {
		"homepage": "https://github.com/B0redBanana/",
		"sources": "https://github.com/B0redBanana/ultimate-fist-bta"
	},
	"icon": "icon.png",
	"license": [
		"GPL-3.0-or-later",
		"LicenseRef-UltimateFist-Assets"
	],
	"environment": "*",
	"entrypoints": {
		"main": [
			"boredbanana.ultimatefist.UltimateFist"
		],
		"client": [
			"boredbanana.ultimatefist.UltimateFistClient"
		]
	},
	"mixins": [
		"ultimatefist.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabricloader}",
		"minecraft": "*",
		"java": ">=${java}"
	},
	"suggests": {
		"modmenu": ">=${modmenu}"
	}
